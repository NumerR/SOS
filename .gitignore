# Правило было из первого коммита и без слэша ловило ЛЮБОЙ каталог с именем
# vendor, в том числе web/js/vendor — а в нём лежит vendored Leaflet (ADR-0041):
# 147 552 B библиотеки и её лицензия, на которые ссылается docs/02 §5. Пока
# правило срабатывало, страница `/map` в клоне получала 404 на <script>, а
# документация утверждала обратное. Скошенное начало пути оставляет защиту для
# каталога сборки в корне и больше не прячет статику фронтенда.
/vendor/
node_modules/

.idea/
.vscode/
.DS_Store

cookies.txt
SOS.zip
SOS.tar.gz

# Парсер расписания (tools/schedule-parser): Python кэширует байткод рядом с
# исходниками, и при каждом прогоне появляется папка, которую коммитить нельзя.
__pycache__/
*.pyc
